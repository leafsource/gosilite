# gosilite 环境变量模板。
#
# 加载顺序：程序启动时读取仓库根 `.env.<GO_ENV>` 文件（GO_ENV 默认 test），
# 再被同名系统环境变量覆盖（系统环境变量优先）。文件为 KEY=VALUE，# 开头为注释。
# 部署生产时不落文件，直接在进程环境里设置这些变量即可。
#
# 变量（留空则回落到 conf/conf.yaml 的本地开发默认值）：

# 运行环境：test | dev | prod（决定加载哪个 .env.<GO_ENV>）
GO_ENV=test

# 服务监听地址（yaml 默认 :8888）
#GOSILITE_SERVER_ADDRESS=:8080

# 是否开启访问日志 true|false（yaml 默认 true）
#GOSILITE_SERVER_ACCESS_LOG=false

# JWT 签名密钥（≥32 字符；生产必填，禁止沿用 yaml 默认值）
GOSILITE_JWT_SECRET=

# PostgreSQL DSN（生产必填）
GOSILITE_DATABASE_DSN=

# Redis 密码（本地无密码可留空）
GOSILITE_REDIS_PASSWORD=

# 对象存储（RustFS/S3）AK/SK（生产必填）
GOSILITE_STORAGE_ACCESS_KEY=
GOSILITE_STORAGE_SECRET_KEY=

# 对象存储 endpoint 与对外访问域名（yaml 默认 http://127.0.0.1:19000 / 127.0.0.1:19000）
#GOSILITE_STORAGE_ENDPOINT=http://127.0.0.1:9000
#GOSILITE_STORAGE_DOMAIN=127.0.0.1:9000

# 开发文档站（Hugo 产物）目录（yaml 默认 docs/hugo/public；生产建议仅内网访问 /docs/）
#GOSILITE_DOCS_DIR=docs/hugo/public

# 调度器执行日志保留天数（yaml 默认 30，必须为正整数）
#GOSILITE_SCHEDULER_LOG_RETENTION_DAYS=30
